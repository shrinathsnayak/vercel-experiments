# Public site URL used for canonical metadata and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional support page URL shown in the navbar as "Support us".
# Set in `.env.local` for local builds, and as a Vercel env var for deploy.
# NEXT_PUBLIC_BUY_ME_A_COFFEE_URL=https://buymeacoffee.com/shrinathsnayak

# --- Docs agent endpoints (no secrets; public routes) ---
# /llms.txt              - docs index for LLMs
# /llms-full.txt         - full docs export for LLMs
# /docs/<page>.md        - per-page Markdown (Accept: text/markdown also works)
# /api/mcp               - MCP server (list_pages, get_page, search)
# /api/search            - Orama search index for the docs UI

# Experiment demos are standalone apps under apps/experiments/<slug>/.
# Copy each experiment's .env.example when you deploy or run that lab.
