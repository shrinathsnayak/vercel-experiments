# Public site URL used for canonical metadata and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional support page URL shown in the navbar as "Support us".
# Set in `.env.local` for local builds, and as a Vercel env var for deploy.
# NEXT_PUBLIC_BUY_ME_A_COFFEE_URL=https://buymeacoffee.com/shrinathsnayak

# Optional public contact email for /contact and Organization JSON-LD contactPoint.
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# IndexNow (Bing/Yandex/etc.) — public key file lives at public/<INDEXNOW_KEY>.txt
# Postbuild submits published experiment docs URLs. Skips on localhost / missing key.
# Set these as Vercel env vars for production deploys.
# INDEXNOW_KEY=your-32-char-key
# INDEXNOW_HOST=vercel-experiments.com

# --- Docs agent endpoints (no secrets; public routes) ---
# /llms.txt                 - agent index with when-to-use guidance
# /llms-full.txt            - full docs export for LLMs
# /developers               - developer portal (API, OpenAPI, MCP)
# /openapi.json             - OpenAPI 3.1 catalog specification
# /api/v1/experiments       - public REST catalog API
# /docs/<page>.md           - per-page Markdown (Accept: text/markdown also works)
# Accept: text/markdown     - homepage + docs content negotiation
# /api/mcp                  - MCP server (list_pages, get_page, search)
# /api/search               - Orama search index for the docs UI

# Experiment demos are standalone apps under apps/experiments/<slug>/.
# Copy each experiment's .env.example when you deploy or run that lab.
